          "fill": "$--annotation",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "A change needs online acceptance, then follows the account to connected devices. An offline device keeps its last confirmed selection until it reconnects. For premium accounts the intro reads “If premium ends, this is the game you can play offline.”",
          "lineHeight": 1.4,
          "fontFamily": "$--font-ui",
