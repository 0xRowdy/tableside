        },
        {
          "type": "text",
          "id": "n7CXr",
          "name": "Annotation",
          "fill": "$--annotation",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Minimal operator-only web app (not the phone app: no tab bar), calling the same privileged operations the tests use. Same dark tokens for speed; it can be plainer. Items older than 24 h are flagged and alerted; severe reports raise an urgent alert over spec 7's escalation channel.",
          "lineHeight": 1.4,
          "fontFamily": "$--font-ui",
          "fontSize": 12,
          "fontWeight": "normal"
        }
      ]
    },
