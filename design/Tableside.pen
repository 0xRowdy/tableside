        },
        {
          "type": "text",
          "id": "qsOEn",
          "name": "Annotation",
          "fill": "$--annotation",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Separate status lines for content, access, allowance, verification and sync. The reset time shown is the grant's actual expiry instant in the allowance timezone, never “tomorrow”. Recheck access asks for a fresh account-access response (and a direct store check for premium). The device clock is never an input. No upgrade prompt here: prompts appear only on setup, exhaustion, the Counting tab and Plan.",
          "lineHeight": 1.4,
          "fontFamily": "$--font-ui",
          "fontSize": 12,
          "fontWeight": "normal"
        }
      ]
    },
    {
      "type": "frame",
      "id": "jVqCS",
      "x": 900,
      "y": 50653,
      "name": "Annotation — S5-04 · time uncertain (not UI)",
      "width": 390,
      "stroke": "$--annotation",
      "strokeWidth": {
        "left": 2
      },
      "layout": "vertical",
      "gap": 6,
      "padding": [
