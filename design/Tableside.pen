            {
              "type": "text",
              "id": "T5qffC",
              "name": "When the count changes a dec",
              "fill": "$--foreground",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "When the count changes a decision",
              "lineHeight": 1.2,
              "fontFamily": "$--font-display",
              "fontSize": 26,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "dlAAP",
              "name": "A deviation is a planned cha",
              "fill": "$--foreground",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "A deviation is a planned change to basic strategy that applies only at a certain true count. Hard 16 against a dealer 10 is the best-known one: basic strategy hits (with late surrender, a two-card 16 surrenders instead), but at a true count of +1 or higher you stand.",
              "lineHeight": 1.55,
              "fontFamily": "$--font-ui",
              "fontSize": 16,
              "fontWeight": "normal"
            },
            {
              "type": "frame",
              "id": "G7ZUV",
              "name": "Index note",
              "width": "fill_container",
              "fill": "$--card",
              "cornerRadius": 14,
              "stroke": "$--control-border",
              "strokeWidth": 1,
              "layout": "vertical",
              "gap": 6,
              "padding": 14,
              "children": [
                {
                  "type": "text",
                  "id": "jvQ8Q",
                  "name": "Our index vs published chart",
                  "fill": "$--foreground",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Our index vs published charts",
                  "lineHeight": 1.55,
                  "fontFamily": "$--font-ui",
                  "fontSize": 14,
                  "fontWeight": "700"
                },
                {
                  "type": "text",
                  "id": "B6cFJ",
                  "name": "Tableside teaches 16 vs 10 a",
                  "fill": "$--muted-foreground",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Tableside teaches standing at +1; the published Illustrious 18 uses 0. Two rules cause differences like this: the teaching-continuation rule and the tie rule, which keeps the basic play when both choices are worth the same. Five of the eleven S17 one-count differences come only from the tie rule and cost nothing measurable, so the published charts aren't wrong.",
                  "lineHeight": 1.55,
                  "fontFamily": "$--font-ui",
                  "fontSize": 14,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "z5HaJr",
                  "name": "Source citation",
                  "fill": "$--primary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Source: Don Schlesinger, Blackjack Attack (3rd ed.), p. 62, Table 5-1, “The Illustrious 18”, as recorded in Tableside's certified S17 index file (row 16 vs T).",
                  "lineHeight": 1.45,
                  "fontFamily": "$--font-ui",
                  "fontSize": 13,
                  "fontWeight": "normal"
                }
              ]
            },
