        },
        {
          "type": "text",
          "id": "x3Dm8K",
          "name": "Annotation",
          "fill": "$--annotation",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Reference panel: shows the certified reference action for the declared rules, labelled Reference (values from #15's certified artifacts). No expected-value, simulation or \"correct\" wording. This copy was retargeted from S17 to H17, so the cell is compared with both its source and the H17 reference (N).",
          "lineHeight": 1.4,
          "fontFamily": "$--font-ui",
          "fontSize": 12,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "cDy2k",
          "name": "Annotation",
          "fill": "$--annotation",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Strategy note: the author's own prose, labelled as theirs, shown after a correction apart from the coach's explanation, never during Check, and never changes behaviour (T).",
          "lineHeight": 1.4,
          "fontFamily": "$--font-ui",
          "fontSize": 12,
          "fontWeight": "normal"
        }
      ]
    },
    {
      "type": "frame",
      "id": "MUR7l",
      "x": 6400,
      "y": 4887,
      "name": "Annotation — 10b Strategy Builder — Craps (not UI)",
      "width": 720,
      "stroke": "$--annotation",
      "strokeWidth": {
        "left": 2
      },
