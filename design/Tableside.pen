        {
          "type": "text",
          "id": "H5Gvz",
          "name": "Annotation",
          "fill": "$--annotation",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Teen variant (spec 5 Amendment 1 D): the free plan for under-18s has no ads and never starts the ad SDK, so \"Ads after results\" becomes \"No ads\". Premium still lists its four benefits; No ads is marked as already on the free plan. Teens stay on the default allowance policy and out of experiments.",
          "lineHeight": 1.4,
          "fontFamily": "$--font-ui",
          "fontSize": 12,
          "fontWeight": "normal"
        }
      ]
    },
    {
      "type": "frame",
      "id": "hV44o",
      "x": 8100,
      "y": 47840,
      "name": "Annotation — S5-01 Plan · restricted (not UI)",
      "width": 390,
      "stroke": "$--annotation",
      "strokeWidth": {
