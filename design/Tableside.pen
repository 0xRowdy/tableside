        12
      ],
      "children": [
        {
          "type": "text",
          "id": "uT67i",
          "name": "Label",
          "fill": "$--annotation",
          "content": "ANNOTATION · NOT IN THE UI",
          "fontFamily": "$--font-ui",
          "fontSize": 10,
          "fontWeight": "700",
          "letterSpacing": 1
        },
        {
          "type": "text",
          "id": "Xz6nJ",
          "name": "Annotation",
          "fill": "$--annotation",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "After a reboot, reinstall, restored backup or missing evidence, time is uncertain: starting metered training and premium-only offline access wait for reconnection (“Reconnect to verify access” replaces any deadline). Finishing a turn, final settlement, saving and history stay available.",
          "lineHeight": 1.4,
          "fontFamily": "$--font-ui",
          "fontSize": 12,
          "fontWeight": "normal"
        }
      ]
    },
    {
      "type": "frame",
