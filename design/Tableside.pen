        },
        {
          "type": "text",
          "id": "LWcCo",
          "name": "Annotation",
          "fill": "$--annotation",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Shown when starting outside the offline game while offline. It's decided before admission, so it is never charged. Starting or resuming beyond cached rights needs a successful account-access response; radio indicators, OS reachability and captive portals never count as online.",
          "lineHeight": 1.4,
          "fontFamily": "$--font-ui",
          "fontSize": 12,
          "fontWeight": "normal"
        }
      ]
    },
    {
