          "letterSpacing": 1
        },
        {
          "type": "text",
          "id": "a7srWG",
          "name": "Annotation",
          "fill": "$--annotation",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Restricted account (story 55): deletion is scheduled, so billing continues visibly and the purchase stays this account's through the 30-day undo. No purchase, plan change or restore; only Manage subscription and How to request a refund. Cancel deletion runs a current-store check and returns only currently verified premium, with no new or refilled allowance. Other restricted gate states (for example an age not yet settled) use this layout with their own banner; a free restricted account shows no Premium offer.",
          "lineHeight": 1.4,
          "fontFamily": "$--font-ui",
          "fontSize": 12,
          "fontWeight": "normal"
        }
      ]
    },
    {
      "type": "frame",
