        },
        {
          "type": "text",
          "id": "gKp7i",
          "name": "Annotation",
          "fill": "$--annotation",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Changes take effect at a daily reset after at least one full allowance day's notice. A notice counts once recorded as shown (a policy-notice operation, uploaded on reconnect). A device that missed it shows it on reconnection, keeps the previous version for that allowance day and switches at the next reset. Budgets never stack, convert or refill.",
          "lineHeight": 1.4,
          "fontFamily": "$--font-ui",
          "fontSize": 12,
          "fontWeight": "normal"
        }
      ]
